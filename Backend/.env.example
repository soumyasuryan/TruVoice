# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Security & JWT
SECRET_KEY=your-jwt-secret-key

# Groq AI Service
GROQ_API_KEY=gsk_your_groq_api_key
GUARDIAN_GROQ_TIMEOUT_SECONDS=4

# SMTP Configuration for OTP and Guardian Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Agora RTC & RTM Real-Time Voice Credentials
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# Public Server Base URL
PUBLIC_SERVER_URL=https://your-ngrok-subdomain.ngrok-free.app

# Real-Time Voice Analysis Chunking Settings
VOICE_ANALYSIS_CHUNK_SECONDS=3.0
VOICE_ANALYSIS_INTERVAL_SECONDS=3.0

# Local faster-whisper GPU transcription. `large-v3-turbo` is recommended for
# an RTX 4050 6 GB GPU; switch to `small` if constrained by GPU memory.
STT_MODEL_SIZE=large-v3-turbo
STT_COMPUTE_TYPE=float16

# TinyFish Live Web Verification & Second Opinion
TINYFISH_API_KEY=your_tinyfish_api_key
TINYFISH_ENABLED=true
WEB_EVIDENCE_TIMEOUT_S=12
CLAIM_MAX_PER_CALL=3
CLAIM_MIN_GAP_S=8
VERIFY_WHEN_SEVERE=false
CACHE_TTL_S=900
OFFICIAL_DOMAINS=rbi.org.in,cybercrime.gov.in,pib.gov.in,sancharsaathi.gov.in,trai.gov.in,npci.org.in,cert-in.org.in,bank.sbi,sbi.co.in,hdfcbank.com,icicibank.com

